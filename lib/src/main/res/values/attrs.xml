<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- glbjk.jar 中可配置的编辑器属性封装 -->
    <declare-styleable name="HighlightEditor">
        <attr name="editorLanguage" format="string" />
        <attr name="editorTextSize" format="dimension" />
        <attr name="editorWordWrap" format="boolean" />
        <attr name="editorShowLineNumbers" format="boolean" />
        <attr name="editorAutoIndent" format="boolean" />
        <attr name="editorAutoComplete" format="boolean" />
        <attr name="editorTabSpaces" format="integer" />
        <attr name="editorAutoIndentWidth" format="integer" />
        <attr name="editorHighlightCurrentRow" format="boolean" />
        <attr name="editorNonPrintingCharVisibility" format="boolean" />
        <attr name="editorLongPressCaps" format="boolean" />
        <attr name="editorZoom" format="float" />
        <attr name="editorChirality" format="boolean" />
        <attr name="editorCaretWidth" format="dimension" />
        <attr name="editorShowRegion" format="boolean" />
        <attr name="editorTypeface" format="reference" />
        <attr name="editorBoldTypeface" format="reference" />
        <attr name="editorItalicTypeface" format="reference" />
    </declare-styleable>
</resources>
